# Stellar Identity SDK — example environment configuration (Issue #516)
#
# Copy to `.env` and fill in values. NEVER commit a real `.env` file and
# NEVER hard-code secrets in source code or documentation. Values that
# look like Stellar secrets always begin with `S` and must only ever come
# from this file (or a secret manager) at runtime.

# --- Issuer account -------------------------------------------------------
# Secret key of the credential-issuer account (testnet or mainnet).
# Generate a testnet keypair in the Stellar Laboratory; fund it via Friendbot.
ISSUER_SECRET_KEY=SREPLACE_WITH_YOUR_OWN_TESTNET_SECRET

# --- SDK / RPC ------------------------------------------------------------
SDK_LOG_LEVEL=info
SDK_TESTNET_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# --- Contract addresses (64-hex-char Stellar contract IDs) ----------------
# Leave unset to use DEFAULT_CONFIGS from the SDK; override per environment.
DID_REGISTRY=
CRED_ISSUER=
REPUTATION_SCORE=
ZK_ATTESTATION=
COMPLIANCE=
